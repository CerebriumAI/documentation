                  },

                  {
                    "group": "Integrations",
                    "expanded": true,
                    "pages": ["v4/examples/langchain-langsmith"]
                  }
                ]
              }
            ]
          },
          {
            "tab": "Migrations",
            "groups": [
              {
                "group": "Migrations",
                "pages": [
                  "migrations/replicate",
                  "migrations/hugging-face",
                  "migrations/mystic"
                ]
